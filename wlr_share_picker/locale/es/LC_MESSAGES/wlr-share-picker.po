msgid "What do you want to share?"
msgstr "¿Qué querés compartir?"

msgid "Arrows to move · Enter or click to share · 1-9 picks directly · type to filter · Esc to cancel"
msgstr "Flechas para moverte · Enter o clic para compartir · 1-9 elige directo · escribí para filtrar · Esc para cancelar"

msgid "Share screen"
msgstr "Compartir pantalla"

msgid "Screen {name}"
msgstr "Pantalla {name}"

msgid "Full monitor"
msgstr "Monitor completo"

msgid "Window"
msgstr "Ventana"

msgid "Cancel"
msgstr "Cancelar"

msgid "Filter by title or app"
msgstr "Filtrar por título o app"

msgid "Nothing matches"
msgstr "Nada coincide"

msgid "Share: "
msgstr "Compartir: "

msgid "{app} wants to share your screen"
msgstr "{app} quiere compartir tu pantalla"
